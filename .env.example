# Turbo AI Environment Variables

# Analytics Configuration
# Set to 'true' to enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Analytics Provider ('google' or leave empty for no-op)
VITE_ANALYTICS_PROVIDER=google

# Google Analytics 4 Measurement ID
# Get this from your GA4 property settings
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Development flags
VITE_DEBUG=false
VITE_LOG_LEVEL=warn

# Feature flags
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true

# Base URL
VITE_BASE_URL=https://turbo-ai.ca

# Blog-only CMS. The main website and product pages do not depend on the API.
# npm run dev starts Vite and the MongoDB blog API together.
# Copy this file to .env.local, select mongodb, and enable after seeding.
# Supabase remains available by selecting supabase instead.
VITE_CMS_PROVIDER=mongodb
VITE_CMS_API_URL=/api/cms
VITE_CMS_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables. Never prefix these with VITE_.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=turbo_ai_cms
CMS_PORT=4100
CMS_HOST=127.0.0.1
CMS_ALLOW_LOCAL_BUILD=false
CMS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
